generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoProducto {
  ENCARGO
  STOCK
}

enum Genero {
  MASCULINO
  FEMENINO
  UNISEX
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String     @unique
  slug        String     @unique
  descripcion String?
  // Guarda un public_id de Cloudinary (mismo criterio que Producto.imagenes),
  // no una URL completa pese al nombre del campo — se usa como imagen de la
  // tarjeta de acceso directo en la home (ver ImagenCategoria.tsx).
  imagenUrl   String?
  // Tamaños en ml que se pueden elegir al cargar un producto de esta
  // categoría — de carga libre desde el admin (CategoriaForm.tsx), no una
  // lista fija: cada categoría define los suyos, y un producto puede sumar
  // un tamaño nuevo que no estaba (ver ProductoForm.tsx), quedando
  // disponible después para el resto de los productos de la categoría.
  mililitrosDisponibles Int[] @default([])
  orden       Int        @default(0)
  activa      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  productos   Producto[]
}

model Producto {
  id           String       @id @default(cuid())
  nombre       String
  slug         String       @unique
  descripcion  String?
  // Notas olfativas por etapa — reemplaza el campo `notas` (string suelto)
  // que tenía el producto antes. Cada una es una lista de ingredientes,
  // editable desde el admin (agregar/editar/quitar).
  notasSalida  String[]     @default([])
  notasCorazon String[]     @default([])
  notasFondo   String[]     @default([])
  genero       Genero       @default(UNISEX)
  // 1 = relevancia baja, 2 = media, 3 = alta (la más relevante). Se usa para
  // ordenar/filtrar el catálogo — ver lib/data.ts.
  relevancia   Int          @default(2)
  tipo         TipoProducto @default(STOCK)
  precios      Json
  // Precio con descuento por tamaño — mismas claves que `precios` (ml en
  // string), pero opcional: un ml sin entrada acá (o con un valor que no es
  // menor al de `precios`) simplemente no tiene descuento aplicado.
  preciosDescuento Json @default("{}")
  mililitros   Int[]
  // Stock por tamaño — claves = ml (string), igual que `precios`. Solo es un
  // límite real para tipo STOCK; ENCARGO se fabrica a pedido y no se acota.
  stock        Json         @default("{}")
  imagenes     String[]
  tieneMuestra Boolean      @default(false)
  activo       Boolean      @default(true)
  destacado    Boolean      @default(false)
  // Orden manual (drag & drop) desde el panel de admin — controla el orden
  // dentro de /admin/productos, no el orden público del catálogo.
  orden        Int          @default(0)
  createdAt    DateTime     @default(now())
  categoriaId  String
  categoria    Categoria    @relation(fields: [categoriaId], references: [id])

  @@index([categoriaId])
  @@index([tipo])
  @@index([orden])
  @@index([relevancia])
  @@index([genero])
}
