# Neon (PostgreSQL serverless) — https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary — https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dxxxxxx"
CLOUDINARY_API_KEY="xxxxxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Upload preset "unsigned" (Settings > Upload > Upload presets > Add upload
# preset > Signing Mode: Unsigned) — lo usa el panel de admin
# (components/admin/ImagenesOrdenables.tsx) para subir imágenes de producto
# directo desde el navegador, sin pasar por el servidor.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="xxxxxxxx"

# Panel de administración (/admin) — cambiar antes de producción.
ADMIN_PASSWORD="cambiar-esta-clave"
ADMIN_SESSION_SECRET="cambiar-este-secreto-largo-y-aleatorio"
